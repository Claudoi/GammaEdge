\appendix
\section{F\'ormulas de M\'etricas de Performance}
\label{app:metrics}
\subsection{Retorno y Riesgo}
\begin{align}
  \text{CAGR} &= \left(\frac{V_T}{V_0}\right)^{252/T} - 1 \\
  \sigma_{ann} &= \sigma_{daily} \cdot \sqrt{252} \\
  \mu_{ann} &= \mu_{daily} \cdot 252
\end{align}
\subsection{Ratios Ajustados por Riesgo}
\begin{align}
  \text{Sharpe} &= \frac{\mu_p - r_f}{\sigma_p} \cdot \sqrt{252} \\
  \text{Sortino} &= \frac{\mu_p - r_f}{\sigma^-_p} \cdot \sqrt{252}, \quad \sigma^- = \sqrt{\E[(r - 0)^2 \mid r < 0]} \\
  \text{Calmar} &= \frac{\text{CAGR}}{\text{MaxDD}} \\
  \text{Omega}(\theta) &= \frac{\int_\theta^\infty (1-F(r))dr}{\int_{-\infty}^\theta F(r)dr}
\end{align}
\subsection{Drawdown}
\begin{align}
  DD_t &= 1 - \frac{V_t}{\max_{s \leq t} V_s} \\
  \text{MaxDD} &= \max_t DD_t \\
  \text{AvgDD} &= \frac{1}{T} \sum_t DD_t
\end{align}
\subsection{M\'etricas de Riesgo de Cola}
\begin{align}
  \text{VaR}_\alpha &= -F^{-1}(1-\alpha) \\
  \text{CVaR}_\alpha &= \E[-r \mid r \leq -\text{VaR}_\alpha] = -\frac{1}{1-\alpha}\int_0^{1-\alpha} F^{-1}(u) du
\end{align}
\subsection{Interpretaci\'on de las M\'etricas}
\begin{longtable}{p{0.18\textwidth} p{0.12\textwidth} p{0.65\textwidth}}
\toprule
\textbf{M\'etrica} & \textbf{Excelente} & \textbf{Interpretaci\'on} \\
\midrule
Sharpe & $> 2$ & Retorno por unidad de riesgo. $> 1$ es bueno, $> 2$ es excelente. \\
Sortino & $> 2.5$ & Como Sharpe pero solo penaliza downside. Mejor para distribuciones asim\'etricas. \\
Calmar & $> 1$ & Retorno por unidad de drawdown. $> 1$ significa 

recuperaci\'on en $< 1$ a\~no. \\
MaxDD & $< 10\%$ & P\'erdida m\'axima desde pico. Cr\'itico para viabilidad psicol\'ogica. \\
VaR 95\% & -- & ``El peor d\'ia de cada 20". No es subaditivo (no es coherente). \\
CVaR 95\% & -- & ``P\'erdida promedio en el peor 5\%". Coherente y convexo. \\
\end{longtable}
